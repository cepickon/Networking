enable 
configure terminal 
no ip domain-look up 
hostname S1 
banner motd #Authorized Access Only!# 
enable secret cisco 
line console 0 
password cisco 
login 
exit 
service password-encryption 

//SSH
ip domain-name s1.com 
username admin privilege 15 secret cisco 
line vty 0 15 
login local 
transport input ssh 
exit 
crypto key generate rsa  
1024 
line vty 0 15
ip ssh version 2

//Turn on ipv6
sdm prefer dual-ipv4-and-ipv6
write memory
reload

//IP address
interface vlan1
ip address 192.168.1.5 255.255.255.0
ipv6 address 2001:db8:acad:1::5/64
no shutdown 
exit 

//Save configuration
exit 
write memory 
