enable 
configure terminal 
no ip domain-look up 
hostname R1 
banner motd #Authorized Access Only!# 
enable secret cisco
line console 0 
password cisco 
login 
exit 
service password-encryption 

//SSH
ip domain-name r1.com 
username admin privilege 15 secret cisco 
line vty 0 4 
login local 
transport input ssh 
exit 
crypto key generate rsa 
1024 
line vty 0 4
ip ssh version 2

//Turn on ipv6
ipv6 unicast-routing

//IP address
interface g0/0/0
ip address 192.168.10.1 255.255.255.0 
ipv6 address 2001:acad:db8:1::1/64
no shutdown
exit 
interface g0/0/1 
ip address 192.168.20.1 255.255.255.0 
ipv6 address 2001:acad:db8:2::1/64
no shutdown
exit 

//Save configuration
exit 
write memory 
